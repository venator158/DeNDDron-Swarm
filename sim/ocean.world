<?xml version="1.0"?>
<sdf version="1.6">
  <world name="ocean_swarm">
    
    <!-- Physics engine configuration
         ODE physics provides stable rigid body dynamics for drone simulation.
         Step size of 0.001s gives 1000Hz physics updates.
         Real time factor of 1 means simulation runs at real-world speed.
    -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Gravity: Disabled (0) - Flight controller will handle hover state
         When agents disconnect, FC automatically hovers the drone.
         With gravity = 0, disconnected drones remain stationary at last velocity.
    -->
    <gravity>0 0 0</gravity>

    <!-- Global ambient lighting for scene -->
    <ambient>0.5 0.5 0.5 1</ambient>

    <!-- Directional light simulating sun
         Provides primary illumination with shadows for visual feedback.
    -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Water surface model
         A large flat plane at z=0 representing the ocean surface.
         Static (non-moving) body with minimal friction.
         Size: 2000x2000 meters provides large play area.
    -->
    <model name="ocean_surface">
      <static>true</static>
      <link name="surface">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.1</mu>
                <mu2>0.1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Water</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ship at the origin: a frigate ~31 m long (bow tip x=+15, stern x=-16), 9 m beam.
         Sized to the simulator's ship model (16 m radius for lidar, 17.5 m keep-out).
         Collision is one hull box; the rest is visual only. Waterline at z=0. -->
    <model name="ship_obstacle">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="hull">
        <collision name="collision">
          <pose>-0.5 0 3 0 0 0</pose>
          <geometry><box><size>31 9 6</size></box></geometry>
        </collision>
        <visual name="hull">
          <pose>-3 0 2.5 0 0 0</pose>
          <geometry><box><size>26 9 5</size></box></geometry>
          <material><ambient>0.33 0.38 0.43 1</ambient><diffuse>0.33 0.38 0.43 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
        <visual name="bow">
          <pose>10.5 0 2.5 0 0 0.7854</pose>
          <geometry><box><size>6.36 6.36 5</size></box></geometry>
          <material><ambient>0.33 0.38 0.43 1</ambient><diffuse>0.33 0.38 0.43 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
        <visual name="deckhouse">
          <pose>-3 0 6.75 0 0 0</pose>
          <geometry><box><size>11 7 3.5</size></box></geometry>
          <material><ambient>0.72 0.74 0.77 1</ambient><diffuse>0.72 0.74 0.77 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
        <visual name="bridge">
          <pose>1.5 0 9.75 0 0 0</pose>
          <geometry><box><size>4 8 2.5</size></box></geometry>
          <material><ambient>0.72 0.74 0.77 1</ambient><diffuse>0.72 0.74 0.77 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
        <visual name="funnel">
          <pose>-7 0 10 0 0 0</pose>
          <geometry><box><size>2.5 2 3</size></box></geometry>
          <material><ambient>0.2 0.22 0.24 1</ambient><diffuse>0.2 0.22 0.24 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
        <visual name="mast">
          <pose>-2 0 14 0 0 0</pose>
          <geometry><cylinder><radius>0.25</radius><length>7</length></cylinder></geometry>
          <material><ambient>0.2 0.22 0.24 1</ambient><diffuse>0.2 0.22 0.24 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
        <visual name="radar">
          <pose>-2 0 17.8 0 0 0</pose>
          <geometry><sphere><radius>1.1</radius></sphere></geometry>
          <material><ambient>0.72 0.74 0.77 1</ambient><diffuse>0.72 0.74 0.77 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
        <visual name="turret">
          <pose>7 0 5.5 0 0 0</pose>
          <geometry><cylinder><radius>1.1</radius><length>1</length></cylinder></geometry>
          <material><ambient>0.72 0.74 0.77 1</ambient><diffuse>0.72 0.74 0.77 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
        <visual name="barrel">
          <pose>9 0 5.8 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>4</length></cylinder></geometry>
          <material><ambient>0.2 0.22 0.24 1</ambient><diffuse>0.2 0.22 0.24 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
        <visual name="helipad">
          <pose>-13 0 5.05 0 0 0</pose>
          <geometry><box><size>6 8 0.1</size></box></geometry>
          <material><ambient>0.22 0.27 0.22 1</ambient><diffuse>0.22 0.27 0.22 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
